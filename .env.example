# Persistent incident database, cursors and imported runbooks.
OPS_DATA_PATH=data
OPS_DEMO_ENABLED=true
# OPS_SOURCES_PATH=config/sources.json
# CONTEXT_CONFIG_PATH=config/context.json
# REMEDIATION_CONFIG_PATH=config/remediation.json

# Compatibility tokens grant only manual operations or read access.
# Personal senior/admin accounts are required for playbook execution.
# OPS_API_TOKEN=replace-with-random-operator-token
# OPS_READ_TOKEN=replace-with-different-random-viewer-token
# ALERT_WEBHOOK_TOKEN=replace-with-different-random-webhook-token
# CACHE_EXECUTOR_TOKEN=replace-with-random-executor-token

# Keep the deterministic offline engine for local development.
LLM_MODE=local

# Optional OpenAI-compatible ReAct engine (used only when LLM_MODE=llm).
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_ITERATIONS=8
# LLM_TIMEOUT_SECONDS=30

# Optional custom structured knowledge base.
# KNOWLEDGE_PATH=knowledge_base/incidents.json
