{
  "window_minutes": 60,
  "timeout_seconds": 8,
  "connectors": [
    {
      "name": "Prometheus CPU",
      "kind": "prometheus",
      "url": "http://127.0.0.1:9090/api/v1/query_range",
      "query": "sum(rate(node_cpu_seconds_total{instance=\"{instance}\",mode!=\"idle\"}[5m]))",
      "timeout_seconds": 5
    },
    {
      "name": "Loki service errors",
      "kind": "loki",
      "url": "http://127.0.0.1:3100/loki/api/v1/query_range",
      "query": "{service=\"{service}\"} |= \"error\"",
      "timeout_seconds": 5
    },
    {
      "name": "Release changes",
      "kind": "changes",
      "url": "http://127.0.0.1:9001/changes",
      "headers": {"Authorization": "Bearer replace-with-read-only-token"}
    },
    {
      "name": "CMDB dependencies",
      "kind": "topology",
      "url": "http://127.0.0.1:9001/topology"
    }
  ]
}
